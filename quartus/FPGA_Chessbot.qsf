set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY DE1_SoC
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VERILOG_INPUT_VERSION VERILOG_2001
set_global_assignment -name SEARCH_PATH ../rtl
set_global_assignment -name VERILOG_FILE ../rtl/DE1_SoC.v
set_global_assignment -name VERILOG_FILE ../rtl/pixel_pll.v
set_global_assignment -name VERILOG_FILE ../rtl/reset_sync.v
set_global_assignment -name VERILOG_FILE ../rtl/button_event.v
set_global_assignment -name VERILOG_FILE ../rtl/chess_game.v
set_global_assignment -name VERILOG_FILE ../rtl/vga_timing.v
set_global_assignment -name VERILOG_FILE ../rtl/chess_renderer.v
set_global_assignment -name VERILOG_FILE ../rtl/chess_core.v
set_global_assignment -name SDC_FILE FPGA_Chessbot.sdc
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
# Exact relevant assignments extracted from the user's DE1_SoC.qsf.
source pins_de1_soc.qsf
# Explicit low-current output characteristics; all pin voltages come from the map.
set_instance_assignment -name CURRENT_STRENGTH_NEW "8MA" -to VGA_*
set_instance_assignment -name SLEW_RATE 1 -to VGA_*
set_instance_assignment -name CURRENT_STRENGTH_NEW "8MA" -to LEDR[*]
set_instance_assignment -name SLEW_RATE 0 -to LEDR[*]

set_global_assignment -name LAST_QUARTUS_VERSION "18.1.0 Lite Edition"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"